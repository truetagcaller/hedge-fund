# ── Application ───────────────────────────────────────────────────
HEDGEFUND_ENV=development
HEDGEFUND_APP__LOG_LEVEL=INFO
HEDGEFUND_APP__JSON_LOGS=false

# ── Data Providers ───────────────────────────────────────────────
HEDGEFUND_DATA__POLYGON__API_KEY=your_polygon_api_key_here

# ── Broker ───────────────────────────────────────────────────────
HEDGEFUND_EXECUTION__BROKER=paper
# Alpaca
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# IBKR
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ── Redis ────────────────────────────────────────────────────────
HEDGEFUND_REDIS__HOST=localhost
HEDGEFUND_REDIS__PORT=6379
HEDGEFUND_REDIS__PASSWORD=

# ── PostgreSQL ───────────────────────────────────────────────────
HEDGEFUND_DATABASE__HOST=localhost
HEDGEFUND_DATABASE__PORT=5432
HEDGEFUND_DATABASE__NAME=hedgefund
HEDGEFUND_DATABASE__USER=postgres
HEDGEFUND_DATABASE__PASSWORD=changeme

# ── Docker Compose overrides ────────────────────────────────────
DASHBOARD_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
POSTGRES_DB=hedgefund
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
